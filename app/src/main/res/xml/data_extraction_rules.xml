<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The device identity lives in no_backup and must never move to another phone:
     a restored copy would give two phones the same device ID. Nothing else needs backing up yet. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
