<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Devices shown in the Share menu of other apps, so a photo can go to a PC in one tap -->
    <share-target android:targetClass="dev.khanlabs.lanshare.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="dev.khanlabs.lanshare.category.SHARE_DEVICE" />
    </share-target>
</shortcuts>
